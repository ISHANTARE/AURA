# AURA v2 — Environment Configuration
# !! This file is git-ignored. NEVER commit this file. !!
# Copy .env.example to .env and fill in your values.

# ── Primary AI Provider (Gemini) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# ── Fallback AI Provider (OpenAI-compatible — leave blank if unused) ─────────
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# ── Dev Feature Flags ─────────────────────────────────────────────────────────
# Set to 'true' to log every Gemini request/response to console
ENABLE_AI_LOGGING=false
# Set to 'true' to force offline mode (skip Gemini, save to offline queue)
FORCE_OFFLINE_MODE=false
